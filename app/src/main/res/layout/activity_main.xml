<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#F4F6F9">

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Control de Acceso IoT"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1A1C1E"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvUserLogged"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Operador: cargando..."
        android:textSize="13sp"
        android:textColor="#5A5F65"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="4dp" />

    <Button
        android:id="@+id/btnLogout"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Salir"
        android:textColor="#BA1A1A"
        app:layout_constraintBaseline_toBaselineOf="@id/tvTitulo"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEstado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/tvUserLogged"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ESTADO DE LA PUERTA"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:textColor="#74777F" />

            <TextView
                android:id="@+id/tvEstadoGeneral"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SINCRONIZANDO..."
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#1A1C1E"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAlerta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="#FFDAD6"
        app:cardCornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/cardEstado"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Alerta: Puerta arrimada sin seguro por tiempo prolongado"
            android:textColor="#93000A"
            android:textSize="13sp"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvSensoresHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sensores Mecanicos (OT)"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#1A1C1E"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/cardAlerta"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvSwMarco"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Switch Marco: Consultando..."
        android:textSize="14sp"
        android:textColor="#44474E"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvSensoresHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvSwCerrojo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Switch Cerrojo: Consultando..."
        android:textSize="14sp"
        android:textColor="#44474E"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/tvSwMarco"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnLock"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:text="Echar Cerrojo (Bloquear)"
        android:textSize="15sp"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toTopOf="@id/btnUnlock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnUnlock"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="24dp"
        android:text="Retirar Cerrojo (Desbloquear)"
        android:textSize="15sp"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>